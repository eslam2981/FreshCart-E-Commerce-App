# FreshCart - Environment Variables Example
# Duplicate this file as .env.local and populate the values

# Backend API Base URL
BASE_URL="https://your-api-domain.com"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret_key_run_openssl_rand_base64_32"

# Google OAuth 2.0 Credentials (Console Google Cloud)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
